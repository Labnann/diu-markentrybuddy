{
    "manifest_version": 3,
    "name": "Marks Entry Helper",
    "version": "0.3",
    "description": "Keyboard and numeric speech-assisted marks entry helper.",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://teacherportal.diu.edu.bd/*",
        "https://cdn.jsdelivr.net/*",
        "https://alphacephei.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://teacherportal.diu.edu.bd/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_title": "Marks Entry Helper",
        "default_popup": "popup.html"
    },
    "version_name": "0.3",
    "web_accessible_resources": [
        {
            "resources": [
                "speech-page.js"
            ],
            "matches": [
                "https://teacherportal.diu.edu.bd/*"
            ]
        }
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    }
}
